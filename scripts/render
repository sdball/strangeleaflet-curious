#!/usr/bin/env node
// Fill marked regions of curio pages from Markdown files beside them.
//
//   <!-- md: notes.md -->
//   …generated HTML, rewritten on every render…
//   <!-- /md -->
//
// Usage: scripts/render [page …]   render every page under public/, or just these
//        scripts/render --check    list pages out of date with their Markdown, exit 1 if any
//        scripts/render --staged   the same check against what's staged (the pre-commit hook)
//        scripts/render --watch    render now, then again whenever a page's Markdown changes
//
// The Markdown is a small subset: paragraphs, - and 1. lists (nested by
// indenting), # headings, ``` fences, **bold** as <b>, *italic* or _italic_
// as <i>, `code`, [links](url), and a trailing \ for a line break. Raw HTML
// passes through, so <span class="v">, <kbd>, and <strong> all work. A line
// that starts with a block tag (<p class="note">, <div>, <table>) starts a
// raw HTML block that runs to the next blank line, untouched.

"use strict";

const fs = require("fs");
const path = require("path");
const { execFileSync } = require("child_process");

const root = path.resolve(__dirname, "..");
const pub = path.join(root, "public");

// ---------- Inline ----------

const ENTITY = /^&(#\d+|#x[0-9a-f]+|[a-z][a-z0-9]*);/i;
const TAG = /^(<!--[\s\S]*?-->|<\/?[a-z][a-z0-9-]*(\s+[^<>]*?)?\/?>)/i;

// & and < become entities unless they already start one or a tag
function escapeText(s) {
  let out = "";
  for (let i = 0; i < s.length; i++) {
    const c = s[i];
    if (c === "&") out += ENTITY.test(s.slice(i)) ? "&" : "&amp;";
    else if (c === "<") out += "&lt;";
    else out += c;
  }
  return out;
}

function escapeCode(s) {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

function escapeAttr(s) {
  return escapeText(s).replace(/"/g, "&quot;");
}

// the index just past a ] or ) that closes the bracket at i, or -1
function closing(s, i, open, close) {
  let depth = 0;
  for (let j = i; j < s.length; j++) {
    if (s[j] === "\\") { j++; continue; }
    if (s[j] === open) depth++;
    else if (s[j] === close && --depth === 0) return j + 1;
  }
  return -1;
}

// code, tags, and links are pulled out first as numbered placeholders, so the
// emphasis pass below only ever sees plain text
function inline(src) {
  const held = [];
  const hold = (html) => `\u0000${held.push(html) - 1}\u0000`;
  let text = "";
  let i = 0;
  while (i < src.length) {
    const rest = src.slice(i);
    const c = src[i];
    if (c === "\\" && /^[\\`*_{}\[\]()#+\-.!<>|~"']/.test(src[i + 1] || "")) {
      text += hold(escapeText(src[i + 1]));
      i += 2;
      continue;
    }
    if (c === "`") {
      const run = rest.match(/^`+/)[0];
      const end = src.indexOf(run, i + run.length);
      if (end !== -1) {
        let code = src.slice(i + run.length, end);
        if (/^ .* $/.test(code)) code = code.slice(1, -1);
        text += hold(`<code>${escapeCode(code)}</code>`);
        i = end + run.length;
        continue;
      }
    }
    if (c === "<") {
      const m = rest.match(TAG);
      if (m) { text += hold(m[0]); i += m[0].length; continue; }
    }
    if (c === "[") {
      const shut = closing(src, i, "[", "]");
      if (shut !== -1 && src[shut] === "(") {
        const end = closing(src, shut, "(", ")");
        if (end !== -1) {
          const label = src.slice(i + 1, shut - 1);
          const href = src.slice(shut + 1, end - 1).trim();
          text += hold(`<a href="${escapeAttr(href)}">${inline(label)}</a>`);
          i = end;
          continue;
        }
      }
    }
    text += c;
    i++;
  }
  return escapeText(text)
    .replace(/\*\*(?=\S)([\s\S]*?\S)\*\*/g, "<b>$1</b>")
    .replace(/\*(?=\S)([\s\S]*?\S)\*/g, "<i>$1</i>")
    .replace(/(?<![\w\u0000])_(?=\S)([\s\S]*?\S)_(?![\w])/g, "<i>$1</i>")
    .replace(/\u0000(\d+)\u0000/g, (_, n) => held[n]);
}

// lines of one paragraph become one line of HTML; a trailing \ breaks it
function joinLines(lines) {
  return lines.map((l) => l.trim()).reduce((acc, l) =>
    acc === null ? l : acc.endsWith("\\") ? `${acc.slice(0, -1)}<br>${l}` : `${acc} ${l}`, null);
}

// ---------- Blocks ----------

const BLOCK_TAG = /^<\/?(address|article|aside|blockquote|details|dialog|div|dl|figure|figcaption|footer|form|h[1-6]|header|hr|nav|ol|p|pre|section|summary|table|ul|!--)[\s>/]/i;
const ITEM = /^( *)([-*]|\d+[.)]) +/;

function indentOf(line) {
  return line.match(/^ */)[0].length;
}

// returns an array of HTML lines
function blocks(lines) {
  const out = [];
  let i = 0;
  const blank = (l) => l.trim() === "";
  while (i < lines.length) {
    const line = lines[i];
    if (blank(line)) { i++; continue; }

    const fence = line.match(/^ *(```+|~~~+)\s*(\S*)/);
    if (fence) {
      const body = [];
      i++;
      while (i < lines.length && !lines[i].trim().startsWith(fence[1])) body.push(lines[i++]);
      i++;
      const cls = fence[2] ? ` class="language-${escapeAttr(fence[2])}"` : "";
      out.push(`<pre><code${cls}>${escapeCode(body.join("\n"))}</code></pre>`);
      continue;
    }

    const head = line.match(/^ *(#{1,6}) +(.*?)(?: +#+)? *$/);
    if (head) {
      const n = head[1].length;
      out.push(`<h${n}>${inline(head[2])}</h${n}>`);
      i++;
      continue;
    }

    if (BLOCK_TAG.test(line.trimStart())) {
      while (i < lines.length && !blank(lines[i])) out.push(lines[i++].trimEnd());
      continue;
    }

    const item = line.match(ITEM);
    if (item) {
      const base = item[1].length;
      const ordered = /\d/.test(item[2]);
      const tag = ordered ? "ol" : "ul";
      const start = ordered && parseInt(item[2], 10) !== 1 ? ` start="${parseInt(item[2], 10)}"` : "";
      out.push(`<${tag}${start}>`);
      // an item is its first line plus every line after it that isn't a
      // sibling item; blank lines inside stay, so an item can hold paragraphs
      const sibling = (l) => {
        const m = l && l.match(ITEM);
        return m && m[1].length === base && /\d/.test(m[2]) === ordered ? m : null;
      };
      while (i < lines.length) {
        // blank lines between two items don't end the list
        let j = i;
        while (j < lines.length && blank(lines[j])) j++;
        const m = sibling(lines[j]);
        if (!m) break;
        i = j;
        const width = m[0].length;
        const body = [lines[i].slice(width)];
        i++;
        while (i < lines.length) {
          const l = lines[i];
          if (blank(l)) {
            // a blank line ends the item unless something indented follows it
            let j = i;
            while (j < lines.length && blank(lines[j])) j++;
            if (j < lines.length && indentOf(lines[j]) > base) { while (i < j) body.push(lines[i++]); continue; }
            break;
          }
          const sib = l.match(ITEM);
          if (sib && sib[1].length <= base) break;
          body.push(indentOf(l) >= width ? l.slice(width) : l.trimStart());
          i++;
        }
        const inner = blocks(body);
        // an item with one paragraph keeps its text bare, as the pages write
        // it, with any nested list after it
        const paras = inner.filter((l) => l.startsWith("<p>")).length;
        if (paras === 1 && inner[0].startsWith("<p>")) inner[0] = inner[0].slice(3, -4);
        out.push(inner.length === 1 ? `  <li>${inner[0]}</li>` : [`  <li>${paras === 1 ? inner.shift() : ""}`, ...inner.map((l) => "    " + l), "  </li>"].join("\n"));
      }
      out.push(`</${tag}>`);
      continue;
    }

    const para = [];
    while (i < lines.length && !blank(lines[i]) && !ITEM.test(lines[i]) && !/^ *(#{1,6} |```|~~~)/.test(lines[i]) && !BLOCK_TAG.test(lines[i].trimStart())) {
      para.push(lines[i++]);
    }
    out.push(`<p>${inline(joinLines(para))}</p>`);
  }
  return out.join("\n").split("\n");
}

function markdown(src) {
  return blocks(src.replace(/\r\n?/g, "\n").replace(/\t/g, "    ").split("\n"));
}

// ---------- Pages ----------

const REGION = /^([ \t]*)<!-- md: *(\S+?) *-->[^\n]*\n[\s\S]*?^[ \t]*<!-- \/md -->[^\n]*$/gm;

// read is (path) => text, so the same render works on staged files
function render(page, read) {
  const dir = path.dirname(page);
  return read(page).replace(REGION, (_, indent, file) => {
    const md = read(path.join(dir, file));
    const html = markdown(md).map((l) => (l ? indent + l : l)).join("\n");
    return `${indent}<!-- md: ${file} -->\n${html}\n${indent}<!-- /md -->`;
  });
}

function marked(text) {
  return /<!-- md: *\S+? *-->/.test(text);
}

function allPages() {
  const found = [];
  const walk = (dir) => {
    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
      const p = path.join(dir, e.name);
      if (e.isDirectory()) walk(p);
      else if (e.name.endsWith(".html") && marked(fs.readFileSync(p, "utf8"))) found.push(p);
    }
  };
  walk(pub);
  return found.sort();
}

const rel = (p) => path.relative(root, p);
const readDisk = (p) => fs.readFileSync(p, "utf8");

function renderAll(pages) {
  let failed = false;
  for (const page of pages) {
    try {
      const before = readDisk(page);
      const after = render(page, readDisk);
      if (after !== before) {
        fs.writeFileSync(page, after);
        console.log(`rendered ${rel(page)}`);
      }
    } catch (err) {
      console.error(`${rel(page)}: ${err.message}`);
      failed = true;
    }
  }
  return !failed;
}

function check(pages, read) {
  const stale = [];
  for (const page of pages) {
    try {
      if (render(page, read) !== read(page)) stale.push(rel(page));
    } catch (err) {
      stale.push(`${rel(page)} (${err.message})`);
    }
  }
  if (stale.length) {
    console.error("These pages are out of date with their Markdown:");
    for (const s of stale) console.error(`  ${s}`);
    console.error("Run scripts/render, then stage the pages.");
  }
  return stale.length === 0;
}

// pages whose own text or whose neighbouring Markdown is staged
function stagedPages() {
  const git = (...args) => execFileSync("git", args, { cwd: root, encoding: "utf8" });
  const names = git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "--", "public/").split("\n").filter(Boolean);
  const pages = new Set();
  for (const name of names) {
    const dir = path.dirname(path.join(root, name));
    if (name.endsWith(".html")) pages.add(path.join(root, name));
    else if (name.endsWith(".md")) {
      for (const f of fs.readdirSync(dir)) if (f.endsWith(".html")) pages.add(path.join(dir, f));
    }
  }
  const readStaged = (p) => git("show", `:${rel(p)}`);
  const present = [...pages].filter((p) => {
    try { return marked(readStaged(p)); } catch { return false; }
  });
  return { pages: present, read: readStaged };
}

function watch() {
  renderAll(allPages());
  console.log("watching public/ for Markdown changes (Ctrl-C to stop)");
  let timer = null;
  fs.watch(pub, { recursive: true }, (_, name) => {
    if (!name || !/\.(md|html)$/.test(name)) return;
    clearTimeout(timer);
    // the page's own writes land here too, and render nothing new the second time
    timer = setTimeout(() => renderAll(allPages()), 100);
  });
}

// ---------- Main ----------

const args = process.argv.slice(2);
const flags = new Set(args.filter((a) => a.startsWith("--")));
const named = args.filter((a) => !a.startsWith("--")).map((a) => path.resolve(a));

if (flags.has("--help")) {
  console.log(fs.readFileSync(__filename, "utf8").split("\n").slice(1, 18).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
} else if (flags.has("--staged")) {
  const { pages, read } = stagedPages();
  process.exit(check(pages, read) ? 0 : 1);
} else if (flags.has("--check")) {
  process.exit(check(named.length ? named : allPages(), readDisk) ? 0 : 1);
} else if (flags.has("--watch")) {
  watch();
} else {
  process.exit(renderAll(named.length ? named : allPages()) ? 0 : 1);
}
