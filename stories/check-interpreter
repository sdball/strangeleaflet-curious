#!/bin/sh
# Play every walkthrough through the Z-Machine Interpreter page's engine and
# through dfrotz, and compare them word by word. Run after changing the
# interpreter. Build the games first (after-hours/check, zork1/check).
cd "$(dirname "$0")" || exit 1
status=0
for w in after-hours/walkthrough-*.txt after-hours/dark-moves.txt after-hours/wrong-moves.txt; do
  ./compare after-hours/after-hours.z3 "$w" >/dev/null || { echo "DIFFERS  $w"; status=1; continue; }
  echo "same     $w"
done
for w in zork1/walkthrough-*.txt; do
  ./compare zork1/zork1.z3 "$w" >/dev/null || { echo "DIFFERS  $w"; status=1; continue; }
  echo "same     $w"
done
exit $status
