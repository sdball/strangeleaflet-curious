#!/bin/sh
# Rebuild Zork III from Infocom's source and walk to the Junction to show it plays.
# The source lives in public/z-machine/zork3/ (the .zil files here are links),
# from github.com/historicalsource/zork3, unchanged. Builds happen here so the
# .zap listings stay out of public/, then the story file and its names go to
# every curio that carries a copy.
cd "$(dirname "$0")" || exit 1
zilf -q -S zork3.zil >build.log 2>&1 || { cat build.log; exit 1; }
# zapf -A finds the abbreviations worth having; assemble again with them
zapf -q -A zork3.zap 2>/dev/null | sed '/^Finding up to/d' > zork3_freq.zap.new || exit 1
mv zork3_freq.zap.new zork3_freq.zap
# -L lists each label's address, which names uses to find the routines
zapf -q -L zork3.zap >zork3_labels.txt 2>build.log || { cat build.log; exit 1; }
rm -f build.log
if dfrotz -m -p -q zork3.z3 < walkthrough-junction.txt 2>/dev/null | grep -q "Junction"; then
  echo "plays walkthrough-junction.txt"
else
  echo "STUCK walkthrough-junction.txt"; exit 1
fi
for dir in ../../public/z-machine/zork3 ../../public/z-machine-interpreter/zork3; do
  cp zork3.z3 "$dir/"
  ../after-hours/names . "$dir/zork3-names.json" zork3 "Zork III: The Dungeon Master"
done
echo "copied zork3.z3 ($(wc -c < zork3.z3 | tr -d ' ') bytes) and zork3-names.json"
